{
  "name": "ferion",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/tech",
    "apps/motion",
    "packages/ui",
    "packages/profile"
  ],
  "scripts": {
    "dev:tech": "npm run dev -w @ferion/tech",
    "dev:motion": "npm run dev -w @ferion/motion",
    "build": "npm run build -w @ferion/tech && npm run build -w @ferion/motion",
    "build:tech": "npm run build -w @ferion/tech",
    "build:motion": "npm run build -w @ferion/motion",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.1"
  }
}
